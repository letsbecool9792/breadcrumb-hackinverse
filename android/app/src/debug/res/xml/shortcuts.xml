<?xml version="1.0" encoding="utf-8"?>
<!-- The main source set's shortcuts, for the debug build: a shortcut's targetPackage is fixed,
     and the debug build's applicationId ends in ".debug". Change both together. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="keep"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_keep"
        android:shortcutShortLabel="@string/shortcut_keep_short"
        android:shortcutLongLabel="@string/shortcut_keep_long">
        <intent
            android:action="com.lbc.breadcrumb.action.KEEP"
            android:targetPackage="com.lbc.breadcrumb.debug"
            android:targetClass="com.lbc.breadcrumb.MainActivity" />
    </shortcut>
    <!-- Voice notes: the "+" sheet, straight on the voice panel, recording. -->
    <shortcut
        android:shortcutId="voice"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_voice"
        android:shortcutShortLabel="@string/shortcut_voice_short"
        android:shortcutLongLabel="@string/shortcut_voice_long">
        <intent
            android:action="com.lbc.breadcrumb.action.VOICE"
            android:targetPackage="com.lbc.breadcrumb.debug"
            android:targetClass="com.lbc.breadcrumb.MainActivity" />
    </shortcut>
</shortcuts>
