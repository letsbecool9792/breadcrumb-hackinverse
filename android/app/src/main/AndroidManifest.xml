<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- The backend, and saved links' pages. Capture never waits on either
         (architecture rule 2). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Reading R4: whether the phone is online when a link's page fails to load.
         Offline, the link waits for the next pass; online, the answer is final. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Each workstream adds its own entries here: capture its activities, its
         Quick Settings tile and the <queries> block for source apps; search the
         FileProvider that opens originals. Keep each entry's comment saying why
         it is there. -->

    <!-- Capture workstream: query launcher apps to read their display name when they share -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- Voice notes: the phone's speech recognizer, which hears them offline. -->
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <application
        android:name=".BreadcrumbApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:enableOnBackInvokedCallback="true"
        android:theme="@style/Theme.Breadcrumb">
        <!-- adjustResize: the search field sits just above the keyboard,
             rather than the whole window panning. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Breadcrumb.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Capture workstream: launcher shortcut (design §13) -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!-- Capture workstream: receive shares and text selection -->
        <activity
            android:name=".capture.ShareReceiverActivity"
            android:label="@string/app_name"
            android:icon="@mipmap/ic_launcher"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Breadcrumb.Capture"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="text/html" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.PROCESS_TEXT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- Capture workstream: receive images and PDFs -->
        <activity
            android:name=".capture.MediaReceiverActivity"
            android:label="@string/app_name"
            android:icon="@mipmap/ic_launcher"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Breadcrumb.Capture"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
                <data android:mimeType="application/pdf" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
                <data android:mimeType="application/pdf" />
            </intent-filter>
        </activity>

        <!-- Capture workstream: Quick Settings tile and clipboard capture -->
        <service
            android:name=".capture.CaptureTileService"
            android:label="@string/tile_label"
            android:icon="@drawable/ic_tile_crumb"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Not exported: only the tile opens it. Exported, any app could make
             Breadcrumb save whatever is on the clipboard. -->
        <activity
            android:name=".capture.ClipboardCaptureActivity"
            android:theme="@style/Theme.Breadcrumb.Capture"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode" />

        <!-- Reading R7: FileProvider for opening and sharing saved originals (architecture rule 1) -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.originals"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/originals_paths" />
        </provider>
    </application>

</manifest>
