# Copy this file to server/.env and fill it in. .env is gitignored; this is not,
# so never put a real password here.

# Atlas connection string. In the Atlas UI: your cluster -> Connect -> Drivers ->
# Node.js, then copy the string and put the database user's password in place of
# <db_password>. If the password contains @ : / ? # % & or a space, URL-encode it
# (@ becomes %40) -- an un-encoded one is read as part of the host and fails with
# a confusing error. Network Access must also allow this machine's IP.
# Every line needs its KEY= prefix: a bare connection string pasted on its own
# makes Node read everything up to the first = as the variable's name.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority&appName=breadcrumb

# Database inside that cluster. Tests use this name with "_test" appended (and a
# suite's own suffix), so running them never touches real memories.
MONGODB_DB=breadcrumb

# Gemini API key, from https://aistudio.google.com/apikey -> Create API key.
# Free, no card. Used for ingest, query parsing and embeddings. Google may use
# free-tier content to improve its products.
GEMINI_API_KEY=

# Optional. The models to use, when the pinned defaults do not suit. Each model
# has its own free-tier allowance, which is why ingest and query parsing use two
# different ones. Must name a version: an alias like gemini-flash-latest is
# refused, since its behaviour would shift under you between runs.
# GEMINI_INGEST_MODEL=gemini-3.5-flash-lite
# GEMINI_QUERY_MODEL=gemini-3.1-flash-lite
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# Calls a minute the ingest model allows. The server waits for a free slot
# rather than be refused. 15 suits Flash Lite; a full Flash allows 5.
# GEMINI_INGEST_PER_MINUTE=15

# Optional. HOST only needs changing if something other than adb reverse has to
# reach the server; PORT must match the port used by adb reverse.
# PORT=3000
# HOST=127.0.0.1
