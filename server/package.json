{
  "name": "breadcrumb-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/index.ts",
    "start": "node --env-file-if-exists=.env src/index.ts",
    "reverse": "adb reverse tcp:3000 tcp:3000",
    "test": "node --env-file-if-exists=.env --test \"src/**/*.test.ts\"",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@google/genai": "^2.22.0",
    "express": "^5.2.1",
    "mongodb": "^7.6.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.2",
    "typescript": "^7.0.2"
  }
}
